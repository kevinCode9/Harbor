# Secret-free environment TEMPLATE.
# Copy to .env and fill locally. Never commit .env.
# Generate APP_KEY with: php artisan key:generate
# Override DB_DATABASE to an isolated file or :memory: — never a protected live DB.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
FORCE_HTTPS=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/example.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Project-specific secrets — placeholders only
ADMIN_PASSWORD=
CF_THREAT_ACCOUNT_ID=
CF_THREAT_API_TOKEN=
