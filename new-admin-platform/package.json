{
  "name": "live-admin-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,admin -c blue,magenta \"npm run dev:server\" \"npm run dev:admin\"",
    "dev:server": "tsx watch services/api/src/server.ts",
    "dev:admin": "vite --config apps/admin-web/vite.config.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:local": "bash scripts/start-local-db.sh",
    "build": "vite build --config apps/admin-web/vite.config.ts && tsc -p services/api/tsconfig.json",
    "preview": "vite preview --config apps/admin-web/vite.config.ts",
    "start": "node services/api/dist/server.js",

    "test": "node --experimental-strip-types --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.15.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
