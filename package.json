{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "npm run db:local --prefix new-admin-platform && npm run dev --prefix new-admin-platform",
        "dev:laravel": "vite",
        "dev:all": "concurrently \"npm run dev:laravel\" \"php artisan serve --host=127.0.0.1 --port=8000\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    }
}
