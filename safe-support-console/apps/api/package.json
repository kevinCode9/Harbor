{
  "name": "@harbor/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_OPTIONS=--experimental-sqlite node dist/index.js",
    "db:push": "NODE_OPTIONS=--experimental-sqlite tsx src/db/migrate.ts",
    "db:seed": "NODE_OPTIONS=--experimental-sqlite tsx src/db/seed.ts"
  },
  "dependencies": {
    "@harbor/shared": "*",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
